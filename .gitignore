# Build
bin/
/frontend/dist
/coconut

# Taskfile local build cache
.task/

# Pi sidecar artifacts
/build/sidecar
# Local agent sessions/transcripts (per-workspace state)
.coconut/
# Local fakepi dev binary (COCONUT_PI_BINARY override; canonical build is /build/bin/fakepi)
/fakepi

# Dependencies — ignore node_modules anywhere in the repo
node_modules/

# Stray lockfile from running npm at the repo root (no root package.json; the
# frontend owns frontend/package-lock.json and frontend/bun.lock)
/package-lock.json

# OS
.DS_Store

# Go
*.test
*.out
